# ─────────────────────────────────────────────────────────────
# Logs & debug files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─────────────────────────────────────────────────────────────
# Dependency directories (never commit these)
node_modules
/.pnp
.pnp.js

# ─────────────────────────────────────────────────────────────
# Build / output folders (frontend & some backends)
dist
dist-ssr
build
coverage
/.next
/.cache
/.parcel-cache

# ─────────────────────────────────────────────────────────────
# Environment variables – NEVER commit real secrets!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# But DO commit example files so others know what to fill
!.env.example

# ─────────────────────────────────────────────────────────────
# Editor / OS / temp files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─────────────────────────────────────────────────────────────
# Testing & coverage
coverage/
.nyc_output/

# ─────────────────────────────────────────────────────────────
# Misc / temporary
*.bak
*.backup
*.tmp
*.temp
.DS_Store
.AppleDouble
.LSOverride

# ─────────────────────────────────────────────────────────────
# Optional: if you have large files or assets you don't want
# *.zip
# *.rar
# large-dataset.csv